{
  "extends":"./tsconfig.json",
  "compilerOptions":{
    "lib":["ESNext","DOM","DOM.Iterable"],
    "paths":{
      "@seelen-ui/lib":["libs/core/src/lib.ts"],
      "@seelen-ui/lib/types":["libs/core/gen/types/mod.ts"],
      "@seelen-ui/types":["libs/core/gen/types/mod.ts"],
      "@std/encoding":["node_modules/@seelen-ui/lib/esm/deps/jsr.io/@std/encoding/1.0.11/mod.d.ts"],
      "react":["./node_modules/preact/compat/"],
      "react/jsx-runtime":["./node_modules/preact/jsx-runtime"],
      "react-dom":["./node_modules/preact/compat/"],
      "react-dom/*":["./node_modules/preact/compat/*"]
    },
    "allowJs":true
  },
  "include":["src/ui/svelte/quick-settings/**/*.ts","src/ui/svelte/quick-settings/**/*.svelte","src/ui/svelte/fancy-toolbar/components/Toolbar.svelte","src/ui/svelte/fancy-toolbar/components/drag-recovery.ts","src/ui/svelte/fancy-toolbar/components/Evaluated/actionEvaluator.ts"],
  "exclude":["node_modules","dist"]
}
